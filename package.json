{
  "name": "cosmosengine-mac",
  "productName": "CosmosEngine-Mac",
  "version": "1.5.0",
  "description": "An offline solar system observatory and free-flight simulator",
  "author": "CosmosEngine",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "test:app": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --mac --dir --x64",
    "dist": "npm run build && electron-builder --mac dmg --x64 && electron-builder --mac dmg --arm64",
    "dist:intel": "npm run build && electron-builder --mac dmg --x64",
    "dist:arm": "npm run build && electron-builder --mac dmg --arm64",
    "test:systems": "node scripts/systems-smoke.mjs",
    "test:visual": "node scripts/visual-smoke.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3"
  },
  "build": {
    "appId": "com.cosmosengine.mac",
    "productName": "CosmosEngine-Mac",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/data/**/*",
      "package.json",
      "CREDITS.md",
      "LICENSE",
      "README.md",
      "DATA-LICENSE.md"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "notarize": false,
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "CosmosEngine-Mac",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
